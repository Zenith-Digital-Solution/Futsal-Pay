# Copy this file to publish/.env and adjust values for your target environment.

# Ports exposed on the host
FRONTEND_PORT=3000
BACKEND_PORT=8000
PGADMIN_PORT=8081

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=futsal
POSTGRES_PORT=5432

# App
SECRET_KEY=change-me-in-production-use-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=11520
DEBUG=False
ALLOWED_HOSTS=*
BACKEND_CORS_ORIGINS=http://144.126.252.228:3000
FRONTEND_URL=http://144.126.252.228:3000
SERVER_HOST=http://144.126.252.228:8000

# Redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email
EMAIL_ENABLED=False
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Futsal Pay
MAILGUN_ENABLED=False
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Payments / payouts
PAYOUT_MODE=PLATFORM
PLATFORM_FEE_PCT=5.0
PLATFORM_KHALTI_SECRET_KEY=
PLATFORM_KHALTI_MOBILE=
PLATFORM_ESEWA_MERCHANT_CODE=
PLATFORM_ESEWA_SECRET_KEY=
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT_NUMBER=
PLATFORM_BANK_ACCOUNT_NAME=
PLATFORM_BANK_SWIFT_CODE=

# Frontend public env
NEXT_PUBLIC_API_URL=http://144.126.252.228:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://144.126.252.228:8000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_GOOGLE_ENABLED=false
NEXT_PUBLIC_GITHUB_ENABLED=false
NEXT_PUBLIC_FACEBOOK_ENABLED=false
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional pgAdmin profile
PGADMIN_EMAIL=admin@futsal.com
PGADMIN_PASSWORD=change-me
